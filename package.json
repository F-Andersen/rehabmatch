{
  "name": "rehabmatch",
  "private": true,
  "engines": { "node": "^20.19.0 || ^22.13.0 || >=24.0.0" },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "lint": "eslint . --max-warnings=0",
    "test:build": "npm run build -w client && playwright test --config=playwright.build.config.ts",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test",
    "e2e:showcase": "npx dotenv-cli -e .env.showcase -e .env -- playwright test --config=playwright.showcase.config.ts",
    "e2e:prepare": "npm run e2e:db:prepare -w server",
    "showcase:portraits": "npm run showcase:portraits -w server",
    "showcase:prepare": "npm run showcase:db:prepare -w server",
    "showcase:seed": "npm run showcase:seed -w server",
    "showcase:verify": "npm run showcase:verify -w server",
    "showcase:verify-catalog": "npm run showcase:verify-catalog -w server",
    "showcase:patch-copy": "npm run showcase:patch-copy -w server",
    "dev:showcase": "npx dotenv-cli -e .env.showcase -e .env -- concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "e2e:visual": "playwright test visual-qa",
    "bench:recommendation": "npm run bench:recommendation -w server",
    "bench:http": "npm run bench:http -w server",
    "openapi:lint": "npx --yes @redocly/cli@1 lint docs/api/openapi.yaml",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:validate": "npm run db:validate -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prisma": "^6.19.0",
    "typescript-eslint": "^8.72.1"
  }
}
