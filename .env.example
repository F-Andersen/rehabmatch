# Educational local-development defaults; copy to .env and REPLACE secrets.
NODE_ENV=development
CLIENT_PORT=5173
API_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://rehabmatch:replace-with-local-password@localhost:5432/rehabmatch?schema=public
POSTGRES_USER=rehabmatch
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=rehabmatch
# Generate a long random secret locally (never commit its actual value).
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_BYTES
SESSION_TTL_HOURS=168
# Bootstrap admin via seed; use an account created for the local demonstration.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_LOCAL_ADMIN_PASSWORD
# Optional public contact details, embedded into the frontend at build time.
# VITE_* values are PUBLIC: never put passwords or private keys here.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_OFFICE=
