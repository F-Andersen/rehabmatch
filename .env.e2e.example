# Copy to .env.e2e (never commit). Used by Playwright global setup and E2E API process only.
REHABMATCH_E2E=1

# Dedicated ports so `npm run dev` (5173/3001) can stay running during manual demo work.
API_PORT=3011
CLIENT_PORT=5174
CLIENT_ORIGIN=http://localhost:5174

# Isolated PostgreSQL database — must be exactly rehabmatch_e2e (not rehabmatch demo DB).
DATABASE_URL=postgresql://rehabmatch:replace-with-local-password@localhost:5432/rehabmatch_e2e?schema=public
E2E_DATABASE_URL=postgresql://rehabmatch:replace-with-local-password@localhost:5432/rehabmatch_e2e?schema=public

# Optional: connection to postgres DB for CREATE DATABASE (same user/password as docker-compose).
E2E_POSTGRES_ADMIN_URL=postgresql://rehabmatch:replace-with-local-password@localhost:5432/postgres?schema=public

# Admin for full-workflows / visual-app-screens (match values in your local .env seed).
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_LOCAL_ADMIN_PASSWORD
