# Copy to .env.showcase (never commit). Presentation database for thesis defense demo.
NODE_ENV=development
API_PORT=3021
CLIENT_PORT=5184
CLIENT_ORIGIN=http://localhost:5184

DATABASE_URL=postgresql://rehabmatch:replace-with-local-password@localhost:5432/rehabmatch_showcase?schema=public
SHOWCASE_DATABASE_URL=postgresql://rehabmatch:replace-with-local-password@localhost:5432/rehabmatch_showcase?schema=public
SHOWCASE_POSTGRES_ADMIN_URL=postgresql://rehabmatch:replace-with-local-password@localhost:5432/postgres?schema=public

SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_BYTES
SESSION_TTL_HOURS=168

SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_LOCAL_ADMIN_PASSWORD

# Optional demo logins (set locally; documented in SHOWCASE-DATABASE.md)
SHOWCASE_PATIENT_EMAIL=showcase.patient@example.test
SHOWCASE_PATIENT_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
SHOWCASE_SPECIALIST_EMAIL=showcase.specialist@example.test
SHOWCASE_SPECIALIST_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
